# ═══════════════════════════════════════════════════════════
# 十交易所整合网格机器人 · 安全配置模板
# 第一次双击“一键启动.bat”会自动复制本文件为 .env。
# 默认所有交易所全部为 paper，不会发送真实订单。
# ═══════════════════════════════════════════════════════════

# 安全默认值：只允许本机访问。不要在没有反向代理鉴权时改为 0.0.0.0。
HOST=127.0.0.1
PORT=8283

# 模拟账户初始余额 USDC（paper 模式共用）
PAPER_BALANCE=10000

# ── 代理 / IP 配置 ────────────────────────────────────────
# 全局代理：同时应用于所有交易所（优先级最高）
# 留空则各交易所使用各自的独立代理配置
# 支持格式：
#   HTTP(S):  http://127.0.0.1:7890
#   SOCKS5:   socks5://127.0.0.1:1080
#   带认证:   socks5://user:pass@host:port
#   简写格式: host:port:user:pass
GLOBAL_PROXY=

# 各交易所独立代理（仅在 GLOBAL_PROXY 未设置时生效）
DECIBEL_PROXY=
EXTENDED_PROXY=
RISEX_PROXY=
ARCUS_PROXY=
LIGHTER_PROXY=
N1_PROXY=
PHOENIX_PROXY=
PHOENIX2_PROXY=
NADO_PROXY=
POPDEX_PROXY=

# ── Decibel 交易所 ────────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）
DE_MODE=paper
# 网络：mainnet | testnet
DE_NETWORK=mainnet

# 实盘凭据（DE_MODE=live 时必填）
# API Key（Bearer Token）：https://geomi.dev/
DECIBEL_API_KEY=
# API 钱包 Ed25519 私钥：https://app.decibel.trade/api
DECIBEL_PRIVATE_KEY=
# Trading Account / subaccount 地址（不是 API 钱包地址）
DECIBEL_SUBACCOUNT=
# 自定义 API URL（留空使用默认）
DECIBEL_API_URL=

# ── Extended 交易所 ───────────────────────────────────────
EX_MODE=paper
EX_NETWORK=mainnet

# 实盘凭据（EX_MODE=live 时必填）
# 在 https://app.extended.exchange/ → API Management 获取；四项必须属于同一子账户
EXTENDED_API_KEY=
EXTENDED_VAULT=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_MAX_FEE=0.0005
EXTENDED_API_URL=

# ── RISEx 交易所 ──────────────────────────────────────────
RS_MODE=paper
RS_NETWORK=mainnet

# 实盘凭据（RS_MODE=live 时必填）：主钱包公开地址 + 已在 RISEx 注册的 session signer 私钥
ACCOUNT_ADDRESS=
SIGNER_PRIVATE_KEY=
RISEX_API_URL=
RISEX_WS_URL=

# ── Arcus 交易所 ──────────────────────────────────────────
# paper=本地模拟资金（使用 Arcus 实时行情）；live=向所选网络发送真实 API 订单
AR_MODE=paper
# mainnet=实盘网络；testnet=测试网络。两种网络的功能均已接入。
AR_NETWORK=mainnet

# Arcus 主钱包公开地址（0x + 40 位十六进制；不是私钥）
ARCUS_ADDRESS=
# 同一钱包下的子账户编号 0-9；填写 Arcus 创建 API key 时返回的 accountIndex（默认主子账户通常为 0）
ARCUS_ACCOUNT_INDEX=0
# Arcus Ed25519 API 公钥（64位十六进制）
ARCUS_API_KEY=
# 二选一：64 位 seed hex / PKCS#8 DER（hex 或 base64），或指向 private.pem 的路径
# 不要填写 Ethereum 主钱包私钥
ARCUS_API_PRIVATE_KEY=
ARCUS_API_PRIVATE_KEY_FILE=
# 网格挂单有效期。Arcus 要求至少约一个月；40天为官方示例的安全值。
ARCUS_GOOD_TIL_DAYS=40
# 仅作为无法读取账户费率时的保守回退值；实盘会优先读取账户当前费率。
ARCUS_FEE_RATE=0.0005
ARCUS_API_URL=
ARCUS_WS_URL=

# ── Robinhood Chain Lighter（RHC）────────────────────────
# paper=本地模拟资金（使用 RHC 主网实时行情）；live=RHC 主网真实交易
LR_MODE=paper
# RHC 目前固定接入官方主网，程序会校验 api.rh.lighter.xyz 与 chainId=466324。
LR_NETWORK=mainnet

# RHC 账户编号（非负整数，不是钱包地址）。在 RHC/Lighter API 页面或账户资料中查看。
LIGHTER_ACCOUNT_INDEX=
# API key 索引必须为 4-254；0-3 是平台保留索引。
LIGHTER_API_KEY_INDEX=
# 二选一：API signing private key，或保存该私钥的本地文件路径。
# 不要填写 Ethereum 主钱包私钥。程序不实现提现、转账和 API key 变更。
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_PRIVATE_KEY_FILE=
# 通常留空；一键启动器会复用兼容的 Python，或准备 .runtime\python\python.exe 便携环境。
LIGHTER_PYTHON=
# 无法读取账户费率时的保守回退值；实盘会优先采用 RHC 市场 maker fee。
LIGHTER_FEE_RATE=0.0005

# ── N1 ─────────────────────────────────────────────────────
# paper=本地模拟；live=连接 N1 主网。实盘下单还需显式设置 N1_TRADING_ARMED=YES。
N1_MODE=paper
N1_KEYPAIR_PATH=secrets/id.json
N1_APP_PUBLIC_KEY=
N1_API_URL=
N1_SOLANA_RPC=
N1_TRADING_ARMED=
N1_FEE_RATE=0.0005

# ── Phoenix / Phoenix2 ────────────────────────────────────
# 两个配置相互独立，分别使用各自 Solana keypair 和账户。
PH_MODE=paper
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=secrets/phoenix.key
PHOENIX_API_URL=
PHOENIX_RPC_URL=
PHOENIX_SYMBOL=
PHOENIX_COMPUTE_UNIT_LIMIT=600000
PHOENIX_ORDER_GAP_MS=800
PHOENIX_FEE_RATE=0.0005

PH2_MODE=paper
PHOENIX2_PRIVATE_KEY=
PHOENIX2_KEYPAIR_PATH=secrets/phoenix2.key
PHOENIX2_API_URL=
PHOENIX2_RPC_URL=
PHOENIX2_SYMBOL=
PHOENIX2_COMPUTE_UNIT_LIMIT=600000
PHOENIX2_ORDER_GAP_MS=800
PHOENIX2_FEE_RATE=0.0005

# ── Nado ───────────────────────────────────────────────────
NADO_MODE=paper
NADO_NETWORK=ink-mainnet
NADO_PRIVATE_KEY=
NADO_KEY_PATH=
NADO_SUBACCOUNT=
NADO_PRODUCT_ID=2
NADO_RPC_URL=
NADO_FEE_RATE=0.0005

# ── PopDEX ─────────────────────────────────────────────────
POPDEX_MODE=paper
POPDEX_NETWORK=mainnet
POPDEX_PRIVATE_KEY=
POPDEX_KEY_PATH=
POPDEX_SYMBOL=BTCUSDT
POPDEX_API_URL=
POPDEX_ORDER_GAP_MS=800
POPDEX_FEE_RATE=0.0005

# ── AI 助手（可选：风控哨兵/日报/市况分析/对话操控/出区间建议）──
# 协议类型：openai | anthropic | gemini
#   openai = 所有 OpenAI 兼容服务（OpenAI/DeepSeek/Kimi/通义/智谱/OpenRouter/Ollama 等）
AI_PROVIDER=openai
AI_API_KEY=
# 接口地址（留空用官方默认）。示例：
#   DeepSeek: https://api.deepseek.com/v1    Kimi: https://api.moonshot.cn/v1
#   通义: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地: http://127.0.0.1:11434/v1
AI_BASE_URL=
# 主模型（复盘/分析/对话）与小模型（哨兵巡检，高频省钱，可留空同主模型）
AI_MODEL=
AI_MODEL_SMALL=
# 哨兵巡检间隔（分钟，0=关闭）；BTC 市况报告间隔（分钟，0=关闭）；日报生成时间（0-23 整点）
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选，配了才会推）：Telegram 机器人 + 通用 Webhook（POST {"text":"..."}）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
